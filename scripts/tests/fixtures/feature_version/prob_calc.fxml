<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="logbook.internal.gui.FeatureVersionFixtureController"
      spacing="8" prefWidth="300" prefHeight="200">
    <TextField fx:id="fixtureInput" />
    <TextField fx:id="fixtureRun" visible="false" managed="false" />
    <Button fx:id="fixtureCalculate" text="Calculate" onAction="#calculate" />
    <Label fx:id="fixtureResult" text="not calculated" />
    <Button fx:id="fixtureSave" text="Save synthetic result" onAction="#save" />
</VBox>
